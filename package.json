{
  "name": "arvenne-separacao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "capturas": "node scripts/capturas.mjs",
    "test": "npm run tipos:conferir && npm run test:rapido && npm run test:banco && npm run test:e2e && npm run build",
    "test:rapido": "npm run typecheck && npm run lint && vitest run --project unidade",
    "typecheck": "tsc -b && tsc -p tsconfig.testes.json --noEmit",
    "test:banco": "vitest run --project banco",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unidade",
    "tipos:gerar": "node scripts/gerar-tipos.mjs",
    "tipos:local": "node scripts/tipos-pendentes.mjs",
    "tipos:conferir": "node scripts/tipos-pendentes.mjs --check",
    "test:trocas": "npm run test:banco",
    "test:trocas:ui": "playwright test --grep 'cliente escolhe troca'",
    "simular": "node scripts/simular.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.71.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
