// Publicação no Cloudflare (Workers com arquivos estáticos): só serve o app pronto da pasta dist.
// "single-page-application": qualquer endereço (/pedidos/..., /t/..., /r/...) abre o index.html.
{
  "name": "arvenne-separacao",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
